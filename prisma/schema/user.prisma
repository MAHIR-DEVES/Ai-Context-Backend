model User {
  id            String    @id @default(uuid())
  name          String
  email         String    @unique
  password      String
  phone         String?   @unique
  avatar        String?

  role          Role      @default(STUDENT)
  status        STATUS    @default(ACTIVE)

  address       String?
  city          String?
  country       String?

  lastLogin     DateTime?
  emailVerified Boolean   @default(false)
  provider      String?   // google, email



  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}